# --- Ragas judge LLM, served locally by Ollama ---
# Install Ollama (https://ollama.com) and pull a model to use as judge. Prefer something
# stronger than the SLM under test, e.g.:
#   ollama pull qwen2.5:7b
OLLAMA_JUDGE_BASE_URL=http://localhost:11434
OLLAMA_JUDGE_MODEL=qwen2.5:7b

# --- Local, free embeddings used by ragas embedding-based metrics ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Paths (defaults shown; override only if you need a different layout) ---
# TESTSET_PATH=eval/testset.json
# PREDICTIONS_PATH=eval/predictions.json
# RESULTS_DIR=eval/results
